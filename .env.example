# Copy this file to .env before starting Docker Compose.

# Set to true only in Azure to authenticate Blob Storage and Service Bus with the
# App Service/Function App managed identity instead of connection strings.
AZURE_USE_MANAGED_IDENTITY=false
# AZURE_STORAGE_ACCOUNT_NAME=xtractstorage
# SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=xtract.servicebus.windows.net
# For a user-assigned identity only:
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# The API, Function worker, and self-hosted SignalR hub must share this secret.
JWT_SECRET=replace-with-a-long-random-secret

# Stable master key used to wrap application-level storage/database data keys.
# Generate a strong secret for every deployment and do not change it after encrypted data is created.
CONFIG_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Protects the hub's internal broadcast endpoint from unauthenticated callers.
REALTIME_BROADCAST_SECRET=replace-with-another-long-random-secret

SIGNALR_ENABLED=true
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_REALTIME_URL=http://127.0.0.1:5080/hubs/documents

# Required to enable POST /api/ingestion/documents for external systems.
DOCUMENT_INGESTION_API_KEY=replace-with-a-long-random-ingestion-key

# Required to start the local Service Bus emulator and its SQL Server dependency.
# Setting ACCEPT_EULA=Y confirms acceptance of both Microsoft container license terms.
ACCEPT_EULA=N
MSSQL_SA_PASSWORD=replace-with-a-strong-local-sql-password
